<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>DevBridge2.BridgeTools</RootNamespace>
    <AssemblyName>DevBridge2.BridgeTools</AssemblyName>
    <Version>$(DevBridgeProductVersion)</Version>
    <AssemblyVersion>$(DevBridgeAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(DevBridgeAssemblyVersion)</FileVersion>
    <InformationalVersion>$(DevBridgeProductVersion)</InformationalVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="RimBridgeServer.Sdk" Version="2.0.0" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
