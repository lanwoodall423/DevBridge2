{
  "schemaVersion": "devbridge-test-recipe/v2",
  "id": "live-stack-diagnostic",
  "description": "Deliberately call one bounded unknown RimBridge tool; the expected failure supplies a real operation identity for RimError correlation.",
  "projects": ["frontier"],
  "inputs": {
    "quicktest": true
  },
  "requiresReady": true,
  "allowInGameMutation": false,
  "success": {
    "quicktestReady": true,
    "companionVerified": true,
    "rimBridgeReady": true
  },
  "operations": [
    {
      "tool": "rimbridge/get_operation",
      "arguments": {
        "operationId": "live-stack-smoke-missing-operation"
      },
      "expect": {
        "success": false
      }
    }
  ],
  "budget": {
    "timeoutSeconds": 120,
    "maxRimWorldLaunches": 0,
    "maxRecipeAttempts": 1,
    "maxCoordinatorRefreshes": 2,
    "stopOnRepeatedFailureFingerprint": true,
    "maxRepeatedFailureCount": 1
  }
}
