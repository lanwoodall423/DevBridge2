<Project>
  <PropertyGroup>
    <!-- Product version source of truth for all buildable DevBridge components. -->
    <DevBridgeProductVersion>1.2.4</DevBridgeProductVersion>
    <DevBridgeAssemblyVersion>$(DevBridgeProductVersion).0</DevBridgeAssemblyVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
