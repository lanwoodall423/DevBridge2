{
  "schemaVersion": "devbridge-test-recipe/v2",
  "id": "horticulture-in-game-suite",
  "description": "Run the Horticulture gameplay assertion suite through its authenticated RimBridgeServer companion.",
  "projects": ["horticulture"],
  "inputs": {
    "quicktest": true
  },
  "requiresReady": true,
  "allowInGameMutation": true,
  "success": {
    "quicktestReady": true,
    "companionVerified": true,
    "rimBridgeReady": true
  },
  "operations": [
    {
      "tool": "horticulture/run_suite",
      "arguments": {
        "scenario": "complete",
        "warmupTicks": 120,
        "settleTicks": 30
      },
      "expect": {
        "success": true,
        "assertions": [
          { "pointer": "/success", "equals": true },
          { "pointer": "/report/status", "equals": "PASS" }
        ]
      }
    }
  ],
  "budget": {
    "timeoutSeconds": 900,
    "maxRimWorldLaunches": 1,
    "maxRecipeAttempts": 1,
    "maxCoordinatorRefreshes": 4,
    "stopOnRepeatedFailureFingerprint": true,
    "maxRepeatedFailureCount": 1
  }
}
