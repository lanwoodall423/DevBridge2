{
  "schemaVersion": "devbridge-test-recipe/v2",
  "id": "live-stack-smoke",
  "description": "Bounded live-stack semantic smoke: the current DevBridge generation must reach RimBridgeServer and answer ping.",
  "projects": ["frontier"],
  "inputs": {
    "quicktest": true
  },
  "requiresReady": true,
  "allowInGameMutation": false,
  "success": {
    "quicktestReady": true,
    "companionVerified": true,
    "rimBridgeReady": true
  },
  "operations": [
    {
      "tool": "rimbridge/ping",
      "arguments": {},
      "expect": {
        "success": true,
        "assertions": [
          { "pointer": "/message", "exists": true }
        ]
      }
    }
  ],
  "budget": {
    "timeoutSeconds": 120,
    "maxRimWorldLaunches": 0,
    "maxRecipeAttempts": 1,
    "maxCoordinatorRefreshes": 2,
    "stopOnRepeatedFailureFingerprint": true,
    "maxRepeatedFailureCount": 1
  }
}
